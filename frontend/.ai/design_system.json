{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Global Design System & Visual Tokens",
  "document": "WEB_FRONTEND_UI_UX_DESIGN.md",
  "authorityRank": 5,
  "themeScopes": {
    "manager": ".mgr-theme",
    "admin": ".admin-theme"
  },
  "tokens": {
    "colorTokens": {
      "primaryAccent": { "name": "Primary Accent (Yellow)", "hex": "#FACC15", "tailwind": "text-yellow-400 bg-yellow-400 border-yellow-400" },
      "primaryAccentHover": { "name": "Primary Accent Hover", "hex": "#EAB308", "tailwind": "hover:bg-yellow-500 hover:text-yellow-500" },
      "primaryAccentDark": { "name": "Primary Accent Dark", "hex": "#CA8A04", "tailwind": "bg-yellow-600" },
      "backgroundDark": { "name": "Page Canvas Background", "hex": "#050505", "tailwind": "bg-[#050505]" },
      "surfaceDark": { "name": "Card / Container Surface", "hex": "#111111", "tailwind": "bg-[#111111]" },
      "surfaceDarkElevated": { "name": "Dropdown / Modal Surface", "hex": "#1A1A1A", "tailwind": "bg-[#1A1A1A]" },
      "borderDark": { "name": "Border Subtle", "hex": "#262626", "tailwind": "border-[#262626]" },
      "borderDarkActive": { "name": "Border Highlight", "hex": "#404040", "tailwind": "border-[#404040]" },
      "textPrimary": { "name": "Primary Text", "hex": "#FFFFFF", "tailwind": "text-white" },
      "textSecondary": { "name": "Secondary Text", "hex": "#A3A3A3", "tailwind": "text-neutral-400" },
      "textMuted": { "name": "Muted Text", "hex": "#737373", "tailwind": "text-neutral-500" },
      "textDisabled": { "name": "Disabled Text", "hex": "#525252", "tailwind": "text-neutral-600" }
    },
    "statusTokens": {
      "success": { "name": "Success Green", "hex": "#22C55E", "bg": "rgba(34, 197, 94, 0.15)", "text": "text-emerald-400", "badge": "bg-emerald-500/10 text-emerald-400 border-emerald-500/20" },
      "warning": { "name": "Warning Amber", "hex": "#F59E0B", "bg": "rgba(245, 158, 11, 0.15)", "text": "text-amber-400", "badge": "bg-amber-500/10 text-amber-400 border-amber-500/20" },
      "danger": { "name": "Danger Red", "hex": "#EF4444", "bg": "rgba(239, 68, 68, 0.15)", "text": "text-rose-400", "badge": "bg-rose-500/10 text-rose-400 border-rose-500/20" },
      "info": { "name": "Info Blue", "hex": "#3B82F6", "bg": "rgba(59, 130, 246, 0.15)", "text": "text-sky-400", "badge": "bg-sky-500/10 text-sky-400 border-sky-500/20" },
      "neutral": { "name": "Neutral Gray", "hex": "#6B7280", "bg": "rgba(107, 114, 128, 0.15)", "text": "text-neutral-400", "badge": "bg-neutral-500/10 text-neutral-400 border-neutral-500/20" }
    },
    "interactionTokens": {
      "touchTarget": "min-h-[44px] min-w-[44px]",
      "focusRing": "focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-yellow-400 focus-visible:ring-offset-2 focus-visible:ring-offset-neutral-950",
      "borderRadius": {
        "button": "rounded-lg",
        "card": "rounded-xl",
        "modal": "rounded-2xl",
        "badge": "rounded-full"
      },
      "transitions": "transition-colors duration-150 ease-in-out motion-reduce:transition-none"
    },
    "typography": {
      "fontFamily": "Inter, system-ui, -apple-system, sans-serif",
      "scale": {
        "h1": "text-2xl sm:text-3xl font-bold tracking-tight text-white",
        "h2": "text-xl sm:text-2xl font-semibold tracking-tight text-white",
        "h3": "text-lg sm:text-xl font-semibold text-white",
        "body": "text-sm sm:text-base font-normal text-neutral-300",
        "caption": "text-xs font-medium text-neutral-400",
        "metric": "text-2xl sm:text-4xl font-extrabold text-white tracking-tight"
      }
    },
    "responsiveBreakpoints": {
      "sm": "640px",
      "md": "768px",
      "lg": "1024px",
      "xl": "1280px",
      "2xl": "1536px"
    }
  }
}

